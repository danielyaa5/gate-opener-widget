# Copy this file to .env only after retrieving the local key.
# Never commit or share the real values.
GATE_DEVICE_ID=
GATE_LOCAL_KEY=
GATE_ADDRESS=192.168.1.100
GATE_PROTOCOL_VERSION=3.5
GATE_API_SECRET=
GATE_BRIDGE_HOST=0.0.0.0
GATE_BRIDGE_PORT=8765
GATE_PULSE_SECONDS=0.5
GATE_COOLDOWN_SECONDS=3
# Optional separate signing secret for the Alexa skill (X-Gate-Client: alexa).
GATE_ALEXA_API_SECRET=
# Optional absolute path to private Ring camera configuration and references.
GATE_CAMERA_CONFIG=
# Optional private configuration for a guarded overnight close rule.
GATE_AUTO_CLOSE_CONFIG=
